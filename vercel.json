{
  "redirects": [
    {
      "source": "/admin/",
      "destination": "/admin",
      "permanent": false
    },
    {
      "source": "/admin/:path+/",
      "destination": "/admin/:path+",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://4-elements-dispatch.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://4-elements-dispatch.vercel.app/admin/:path*"
    }
  ]
}
